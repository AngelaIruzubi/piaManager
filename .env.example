# Variables para docker compose. Copia este archivo como .env y cambia los valores:
#   cp .env.example .env
# El .env NO se sube a GitHub.

# Base de datos PostgreSQL
POSTGRES_USER=pia_user
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_DB=pia_manager

# Clave para firmar los tokens de sesión (JWT): una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=8h

# Opcional: puerto en el que se abre la app (por defecto 8080)
# APP_PORT=8080
