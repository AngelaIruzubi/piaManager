# Variables para docker-compose.prod.yml en el servidor de producción.
# En el servidor, copia este archivo como .env y rellena los secretos:
#   cp .env.prod.example .env
# El .env con los valores reales NUNCA se sube a GitHub (este repositorio es público).
#
# Los secretos se generan en el servidor con un valor largo y aleatorio, nunca inventados a mano:
#   openssl rand -hex 32

# --- Despliegue ---
# Versión de la imagen del backend publicada en GHCR (la etiqueta de la Release, sin la "v").
# Siempre una versión fija, nunca "latest": así se sabe qué código hay en producción y se puede volver atrás
VERSION=1.1.0
# Dominio para el que Caddy pide el certificado HTTPS a Let's Encrypt
DOMINIO=piamanager.duckdns.org
# Carpeta del Volume de Hetzner: aquí se guardan los datos de PostgreSQL y los certificados de Caddy
DATOS_DIR=/mnt/datos

# --- Base de datos PostgreSQL ---
POSTGRES_USER=pia_user
POSTGRES_PASSWORD=genera_uno_con_openssl_rand_hex_32
POSTGRES_DB=pia_manager

# --- Sesiones (JWT) ---
# Clave para firmar los tokens de sesión. Si cambia, todas las sesiones abiertas dejan de valer
JWT_SECRET=genera_uno_con_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# --- Coordinadora inicial (solo la usa el seed la primera vez) ---
ADMIN_EMAIL=admin@pia.com
# Mínimo 8 caracteres
ADMIN_PASSWORD=genera_uno_con_openssl_rand_hex_32
