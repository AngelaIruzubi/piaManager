// Configuración de knip: detecta dependencias, archivos y exportaciones sin usar.
// Lo ejecuta el CI en cada PR (job "Librerías no usadas (knip)"). Para lanzarlo en local: npx knip
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Los tipos e interfaces que solo se usan dentro de su propio archivo no son código muerto
  // (por ejemplo, Area u Objetivo en pai.model.ts, que forman parte del tipo Pai)
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },

  "workspaces": {
    ".": {},

    "backend": {
      // Punto de entrada extra: las migraciones se cargan por patrón desde config/database.ts, no con
      // un import. El resto lo deduce knip solo: el arranque (src/index.ts) desde "main" del
      // package.json y el seed desde el script "npm run seed"
      "entry": ["src/migrations/*.ts"],
      // Se usarán en los tests de integración de la Fase 3 (Supertest)
      "ignoreDependencies": ["supertest", "@types/supertest"]
    },

    "frontend": {}
  }
}
